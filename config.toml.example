filter_team_submissions = ["domjudge"]
team_group_map = { "team301" = "star" }

[presentation]
rows_per_page = 12
scroll_animation_seconds = 0.5
row_fly_animation_seconds = 0.5
logo_extension = "jpg"
team_photo_extension = "jpg"
team_photo_fallback_path = "/135769226_p0.png"
# After the frozen-scoreboard browse, auto-resolve rows below the lowest final medal rank,
# then wait at that row. Applies even when auto_advance_enabled = false; custom awards
# do not affect the cutoff, and award pages are suppressed during this lead-in.
skip_no_medal = true
# Opening top-to-bottom browse duration, after a separate one-second pause at the top.
intro_scroll_seconds = 8.0
auto_advance_enabled = false
# Show a collective award page after each medal batch (default: false).
# Independent of auto_advance_enabled; each medal's batch_size sets the group size.
batch_award_enabled = false
# Seconds per logical step (not per team), also used by the below-medal-boundary lead-in.
auto_advance_interval_seconds = 1.0
# Time to show each award page after its fade-in, separate from normal resolution steps.
auto_advance_award_interval_seconds = 5.0
# Seconds for one complete loop of all names on an overflowing batch award page.
# Speed is calculated from the rendered list height; the initial 2-second pause is separate.
batch_name_scroll_cycle_seconds = 30.0
# Fraction of column space for names, after outer margins and column gaps (0.1-0.9).
# The left and right image columns each receive half of the remaining space.
batch_name_width_ratio = 0.5
